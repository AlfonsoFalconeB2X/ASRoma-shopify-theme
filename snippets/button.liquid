{%- comment -%}
  ----------------------------------------------------------------------------------------------------------------------
  BUTTON COMPONENT
  ----------------------------------------------------------------------------------------------------------------------

  Generate a button (or link styled as a button). It supports wide range of attributes that can be used to customize
  the appearance and functionality of the button.

  ********************************************
  Supported variables
  ********************************************

  * content: the content of the button
  * href: an optional link to set. If href is provided, then an "a" tag is generated, otherwise a "button"
  * size: can be "sm". If none is set, the default "base" size is used.
  * background: an optional background color to use that override the default
  * text_color: an optional text color to use that override the default
  * text_style: custom text style classes. If none is set, "ASRomaFont Small ExtraBold" is used
  * style: "solid", "outline" or "link". If none is set "solid" is assumed
  * stretch: if passed to true, a full width button is generated
  * subdued: when using the "outline" mode, this reduced the importance of the button
  * type: when href is empty, can be either "button" or "submit" (default to button if none is set)
  * name: when the button is a real button, allow to set the name attribute that is submitted
  * icon: the name of an optional icon to render along the button
  * icon_position: the position of the icon, either "left" or "right"
  * disabled: if set to true, the button is disabled
  * form: the form ID that this button is linked to
  * external: if set to true and that a href is passed, it opens into a new window
  * aria_controls: the ID of the element controlled
  * aria_expanded: if set to true, the button is considered expanded
  * focusable: if set to false, a tabindex="-1" is added to ensure the button is not focusable
  * block: an optional block to output theme editor attributes
  * extra_classes: additional classes to add to the button
  * on_click: an optional JavaScript function to call when the button is clicked
  * variant: primary, secondary (used to apply specific styles)
  * icon_width: width of the icon
  * icon_height: height of the icon
  * circle_button: if set to true, the button is rendered as a circle button (only if no content is provided)
  * id: an optional ID to set on the button
  * full_on_mobile: if set to true, the button will be full width on mobile devices
  * data_layer: an optional data layer attribute to add to the button for tracking purposes
{%- endcomment -%}

{% assign default_text_style = 'ExtraBold ' -%}
{% assign icon_width_default = '6px' -%}
{% assign icon_height_default = '14px' -%}

{%- if style == 'link' -%}
  {% assign default_text_style = 'Regular ' %}
  {% assign icon_width_default = '4px' -%}
  {% assign icon_height_default = '7px' -%}
{%- endif -%}

{%- if icon_width != blank -%}
  {% assign icon_width_default = icon_width %}
{%- endif -%}

{%- if icon_height != blank -%}
  {% assign icon_height_default = icon_height %}
{%- endif -%}


{% liquid
  capture class_attribute
    if style == 'link'
      echo 'asroma-button-link'
    else
      if circle_button and content == blank
        if size != blank and size != 'base'
          echo ' circle-button--' | append: size
        endif
        echo ' circle-button'
      else
        if size != blank and size != 'base'
          echo ' button-' | append: size
        endif
        echo ' asroma-button'
      endif


      if style == 'solid'
        echo ' button--solid'
      endif

      if style == 'outline'
        echo ' button--outline'
      endif

      if subdued
        echo ' button--subdued'
      endif

      if stretch
        echo ' w-full'
      endif

      if full_on_mobile
        echo ' form-control--full-mobile'
      endif
    endif

    if variant == 'secondary'
      echo ' button-secondary'
    else
      echo ' button-primary'
    endif

    if extra_classes != blank
      echo ' ' | append: extra_classes
    endif
  endcapture

  capture style_attribute
    if style != 'link'
      if background != blank and background != 'rgba(0,0,0,0)'
        echo '--button-background: ' | append: background.rgb | append: ';'
        echo '--button-outline-color: ' | append: background.rgb | append: ';'
      endif

      if text_color != blank and text_color != 'rgba(0,0,0,0)'
        echo '--button-text-color: ' | append: text_color.rgb | append: ';'
      endif
    endif
  endcapture

  capture attributes
    if class_attribute != blank
      echo ' class="ASRomaFont Small ' | append: default_text_style | append: class_attribute | append: '"'
    endif

    if style_attribute != blank
      echo ' style="' | append: style_attribute | append: '"'
    endif

    if aria_controls
      echo ' aria-controls="' | append: aria_controls | append: '"'
    endif

    if aria_expanded
      echo ' aria-expanded="' | append: aria_expanded | append: '"'
    endif

    if disabled
      if href
        echo ' role="link" aria-disabled="true"'
      else
        echo ' disabled'
      endif
    endif

    if name
      echo ' name="' | append: name | append: '"'
    endif

    if form
      echo ' form="' | append: form | append: '"'
    endif

    if href
      echo ' href="' | append: href | append: '"'
    endif

    if external and href != blank
      echo ' target="_blank"'
    endif

    if focusable == false
      echo ' tabindex="-1"'
    endif

    if on_click != blank
      echo ' onclick="' | append: on_click | append: '"'
    endif

  endcapture
%}

{%- capture button_content -%}
  {% if circle_button and content == blank %}
    {% if icon != blank %}
      {%- render 'icon' with icon , width: icon_width_default, height: icon_height_default -%}
    {% endif %}
  {% elsif icon != blank %}
    {% if icon_position == 'left' %}
      {%- render 'icon' with icon , width: icon_width_default, height: icon_height_default -%}
      {{ content }}
    {% else %}
      {{ content }}
      {%- render 'icon' with icon , width: icon_width_default, height: icon_height_default -%}
    {% endif %}
  {%- else -%}
    <span class="{{ text_style | default: default_text_style }}">{{- content -}}</span>
  {%- endif -%}
{%- endcapture -%}
<button
  id="{{ id }}"
  type="{{ type | default: 'button' }}"
  {% if href != blank %}
  onclick="{% if external %}window.open('{{ href }}', '_blank');{% else %}window.location.href='{{ href }}';{% endif %}{% if on_click != blank %} {{ on_click }}{% endif %}"
  {% elsif on_click != blank %}
  onclick="{{ on_click }}"
  {% endif %}
  {{ attributes }}
  {{ block.shopify_attributes }}
  {% if settings.enable_datalayer %}
  data-datalayer-info='{{ data_layer }}'
  data-datalayer-event="click"
  {% endif %}>
  {{- button_content -}}
</button>
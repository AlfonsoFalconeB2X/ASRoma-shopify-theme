{%- comment -%}
  ----------------------------------------------------------------------------------------------------------------------
  PRODUCT BADGES COMPONENT
  ----------------------------------------------------------------------------------------------------------------------

  This component is used in product listing and product page to render the badges of a given product

  ********************************************
  Supported variables
  ********************************************

  * product: the product to render the badges
  * variant: the specific variant to show the badge from
  * vertical: if set to true, the badges are outputted vertically
  * types: the types of badge to output. Can be "custom", "sold_out" or "discount" (or a combination separated by comma). If nothing is set, all badges are outputted.
  * context: can be "product" or "card"
{%- endcomment -%}

{%- liquid
  assign badge_types = types | default: 'custom, sold_out, discount' | split: ','
  assign variant = variant | default: product.selected_or_first_available_variant
-%}

{%- capture badges -%}
  {%- for badge_type in badge_types -%}
    {%- assign stripped_badge_type = badge_type | strip -%}

    {%- case stripped_badge_type -%}
      {%- when 'custom' -%}
        {%- assign custom_badges = product.metafields.custom.badges.value -%}

        {%- if custom_badges != blank and custom_badges.size > 0 -%}
          <div class="badge--custom-list">
            {%- for custom_badge in custom_badges -%}
              <span class="badge badge--custom badge--{{ custom_badge | handle }} ASRomaFont ExtraSmall ExtraBold Uppercase">{{ custom_badge }}</span>
            {%- endfor -%}
          </div>
        {%- endif -%}

      {%- when 'sold_out' -%}
        {%- if settings.show_sold_out_badge and variant.available == false -%}
          <sold-out-badge class="badge badge--sold-out ASRomaFont ExtraSmall ExtraBold Uppercase">
            {{- 'product.general.sold_out_badge' | t -}}
          </sold-out-badge>
        {%- endif -%}

      {%- when 'discount' -%}
        {%- if settings.show_discount -%}
          {%- liquid
            assign show_on_sale_badge = false

            if context == 'product'
              if variant.compare_at_price > variant.price
                assign show_on_sale_badge = true
              endif
            elsif context == 'card'
              if variant.compare_at_price > variant.price
                assign show_on_sale_badge = true
              endif
            endif
          -%}

          {%- if variant.compare_at_price > variant.price -%}
            {%- if settings.discount_mode == 'percentage' -%}
              {%- assign savings = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round | append: '%' -%}
            {%- else -%}
              {%- capture savings -%}{{ variant.compare_at_price | minus: variant.price | money }}{%- endcapture -%}
            {%- endif -%}

            {%- if show_on_sale_badge -%}
              <on-sale-badge class="badge badge--on-sale ASRomaFont ExtraSmall ExtraBold Uppercase">
                {%- liquid
                  if context == 'product'
                    echo 'product.general.discount_badge_html' | t: savings: savings
                  elsif context == 'card'
                    echo '-' | append: savings
                  endif
                -%}
              </on-sale-badge>
            {%- endif -%}
          {%- endif -%}
        
      {%- endif -%}

      {%- if product.metafields.custom.customization_settings != blank -%}
      <a class="badge--customizable-container-{{ context }}" href="{{ product_url | default: '#' }}">
          <div class="badge badge--customizable">
            {%- render 'icon' with 'as-roma-customize', width: 13, height: 13 -%}
            <span class="badge--customizable-text-{{ context }} ASRomaFont ExtraSmall ExtraBold Uppercase">
            {{ 'product.general.customizable_badge' | t }}
            </span>
          </div>
        </a>
      {%- endif -%}

    {%- endcase -%}
  {%- endfor -%}
{%- endcapture -%}
{%- capture new_badge -%}
  {%- liquid
    assign start_date = product.metafields.custom.start_new_product_tag.value
    assign end_date = product.metafields.custom.end_new_product_tag.value
    assign current_date = 'now' | date: '%s' | plus: 0
    assign show_new_badge = false

    if start_date != blank or end_date != blank
      assign show_new_badge = true

      if start_date != blank
        assign start_timestamp = start_date | date: '%s' | plus: 0
        if current_date < start_timestamp
          assign show_new_badge = false
        endif
      endif

      if end_date != blank
        assign end_timestamp = end_date | date: '%s' | plus: 0
        if current_date > end_timestamp
          assign show_new_badge = false
        endif
      endif
    endif
  -%}
  {%- if show_new_badge -%}
    <span class="badge badge--new ASRomaFont ExtraSmall ExtraBold Uppercase">
      {{ 'product.general.new_badge' | t }}
    </span>
  {%- endif -%}
{%- endcapture -%}
{%- if badges != blank or new_badge != blank -%}
  <div class="badge-list badge-container-{{ context }}">
    {%- if badges != blank -%}
      <badge-list class="badge-list {% if vertical %}badge-list--vertical{% endif %}">
        {{- badges -}}
      </badge-list>
    {%- endif -%}
    {%- if new_badge != blank -%}
      <badge-list class="badge-list {% if vertical %}badge-list--vertical{% endif %}">
        {{- new_badge -}}
      </badge-list>
    {%- endif -%}
  </div>
{%- endif -%}
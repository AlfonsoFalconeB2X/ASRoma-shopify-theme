{%- comment -%}
  ----------------------------------------------------------------------------------------------------------------------
  PRODUCT CUSTOMIZATION ADD TO CART
  ----------------------------------------------------------------------------------------------------------------------

  This component renders the add to cart button for products with customization settings.

  ********************************************
  Supported variables
  ********************************************

  * product: the product to add to cart
  * selected_variant: the selected variant (optional)
  * useSharedHook: if true, uses the shared store (default: true)
  * store_name: custom store name (optional)
{%- endcomment -%}

{%- assign button_text = button_text | default: 'product.general.add_to_cart_button' | t -%}

<div class="product-customization-add-to-cart">
  <div
    class="add-to-cart-button-react"
    data-store-name="{%- if useSharedHook == true or useSharedHook == 'true' -%}shared{%- elsif store_name and store_name != '' -%}{{ store_name }}{%- else -%}custom-{{ product.handle }}{%- endif -%}"
    data-language="{{ request.locale.iso_code }}"
    data-add-to-cart-button-text="{{ button_text }}">
    <button class="ASRomaFont Small ExtraBold asroma-button button--solid w-full button-primary Uppercase" disabled>{{ button_text }}</button>
  </div>
</div>

<script type="module" src="{{ 'react-addToCartButton.min.js' | asset_url }}"></script>
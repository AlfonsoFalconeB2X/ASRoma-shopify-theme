{%- assign n_intervals = 10 -%}

{%- if min_width == blank or min_width == '' -%}
  {%- assign min_width = 250 -%}
{%- endif -%}
{%- if max_width == blank or max_width == '' -%}
  {%- if image.width > 3000 -%}
    {%- assign max_width = 3000 -%}
  {%- else -%}
    {%- assign max_width = image.width -%}
  {%- endif -%}
{%- endif -%}

{%- assign diff = max_width | minus: min_width -%}
{%- if diff < 500 -%}
  {%- assign interval = diff | divided_by: n_intervals | times: 2 -%}
{%- else -%}
  {%- assign interval = diff | divided_by: n_intervals -%}
{%- endif -%}

{%- assign intervals = '' -%}
{%- for i in (0..n_intervals) -%}
  {%- assign partial = i | times: interval-%}
  {%- assign width = min_width | plus: partial -%}
  {%- assign intervals = intervals | append: width | append: ',' -%}
{%- endfor -%}
{%- assign intervals = intervals | split: ',' -%}

{%- for i in intervals -%}
  {{ image | image_url: width: i }} {{ i }}w
  {%- unless forloop.last -%}
    ,
  {%- endunless -%}
{%- endfor -%}
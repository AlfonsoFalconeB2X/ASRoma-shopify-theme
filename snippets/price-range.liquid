{%- comment -%}
  ----------------------------------------------------------------------------------------------------------------------
  PRICE RANGE
  ----------------------------------------------------------------------------------------------------------------------

  Create a price range selector (used in product faceting)

  ********************************************
  Supported variables
  ********************************************

  * filter: the filter object to use
{%- endcomment -%}

{%- assign range_identifier = filter.min_value.param_name | replace: '.', '-' | replace: '_', '-' | handle -%}
<price-range class="price-range" id="price-range-{{ range_identifier }}">
  {%- liquid
    assign min_value = filter.min_value.value | default: 0.0 | divided_by: 100.0
    assign max_value = filter.max_value.value | default: filter.range_max | divided_by: 100.0
    assign range_max = filter.range_max | divided_by: 100.0 | ceil
    assign lower_bound_progress = min_value | divided_by: range_max | times: 100.0
    assign higher_bound_progress = max_value | divided_by: range_max | times: 100.0
  -%}

  <div class="range-group" style="--range-min: {{ lower_bound_progress }}%; --range-max: {{ higher_bound_progress }}%">
    <input
      type="range"
      aria-label="{{ 'collection.faceting.price_filter_from' | t }}"
      class="range"
      min="0"
      max="{{ range_max | ceil }}"
      value="{{ min_value | ceil }}">
    <input
      type="range"
      aria-label="{{ 'collection.faceting.price_filter_to' | t }}"
      class="range"
      min="0"
      max="{{ range_max | ceil }}"
      value="{{ max_value | ceil }}">
  </div>

  <div class="input-group">
    <label class="input-prefix text-black Body">
      <span class="prefix text-subdued">{{ cart.currency.symbol }}{% if settings.currency_code_enabled %}
          {{ cart.currency.iso_code }}{% endif %}
      </span>
      <input
        aria-label="{{ 'collection.faceting.price_filter_from' | t }}"
        class="field"
        type="number"
        inputmode="numeric"
        {% if filter.min_value.value %}
        value="{{ min_value | ceil }}"
        {% endif %}
        name="{{ filter.min_value.param_name }}"
        id="{{ filter.min_value.param_name }}"
        min="0"
        max="{{ max_value | ceil }}"
        placeholder="0"
        autocomplete="off">
    </label>

    <span class="text-subdued text-black Body">-</span>

    <label class="input-prefix text-black Body">
      <span class="prefix text-subdued">{{ cart.currency.symbol }}{% if settings.currency_code_enabled %}
          {{ cart.currency.iso_code }}{% endif %}
      </span>
      <input
        aria-label="{{ 'collection.faceting.price_filter_to' | t }}"
        class="field"
        type="number"
        inputmode="numeric"
        {% if filter.max_value.value %}
        value="{{ max_value | ceil }}"
        {% endif %}
        name="{{ filter.max_value.param_name }}"
        id="{{ filter.max_value.param_name }}"
        min="{{ min_value | ceil }}"
        max="{{ range_max | ceil }}"
        placeholder="{{ range_max | ceil }}"
        autocomplete="off">
    </label>
  </div>

  <input
    type="hidden"
    id="price-range-badge-{{ range_identifier }}"
    value=""
    data-filter-badge="true"
    data-filter-badge-type="price-range"
    data-filter-badge-input="price-range-badge-{{ range_identifier }}"
    data-filter-badge-group="{{ filter.label | escape }}"
    data-filter-badge-min-input="{{ filter.min_value.param_name }}"
    data-filter-badge-max-input="{{ filter.max_value.param_name }}"
    data-filter-badge-range-id="price-range-{{ range_identifier }}"
    data-filter-badge-range-min="0"
    data-filter-badge-range-max="{{ range_max | ceil }}"
    data-filter-badge-currency-symbol="{{ cart.currency.symbol }}"
    data-filter-badge-show-iso="{{ settings.currency_code_enabled | json }}"
    {% if settings.currency_code_enabled %}
    data-filter-badge-currency-iso="{{ cart.currency.iso_code }}"
    {% endif %}>
</price-range>
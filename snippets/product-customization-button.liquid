{%- comment -%}
  ----------------------------------------------------------------------------------------------------------------------
  PRODUCT CUSTOMIZATION BUTTON
  ----------------------------------------------------------------------------------------------------------------------

  This component renders the customization button for products with customization settings.

  ********************************************
  Supported variables
  ********************************************

  * drawer_id: the id of the drawer to open (optional, defaults to 'product-customization-drawer')
  * useSharedHook: if true, uses the shared store (default: true)
  * store_name: custom store name (optional)
  * product: the product (used for fallback store name)
{%- endcomment -%}

{%- assign drawer_id = drawer_id | default: 'product-customization-drawer' -%}
{%- assign button_text = button_text | default: 'product.general.customize_button' | t -%}


<div class="product-customization-button">
  <div
    class="product-customization-button-react"
    data-store-name="{%- if useSharedHook == true or useSharedHook == 'true' -%}shared{%- elsif store_name and store_name != '' -%}{{ store_name }}{%- else -%}custom-{{ product.handle }}{%- endif -%}"
    data-language="{{ request.locale.iso_code }}"
    data-drawer-id="{{ drawer_id }}"
    data-customization-button-text="{{ button_text }}">
    <button
      type="button"
      class="ASRomaFont Small ExtraBold asroma-button button--outline button-primary w-full Uppercase"
      disabled>{{ button_text }}</button>
  </div>
</div>

<script type="module" src="{{ 'react-productCustomizationButton.min.js' | asset_url }}"></script>
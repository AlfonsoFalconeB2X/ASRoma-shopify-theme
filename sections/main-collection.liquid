{%- liquid
  assign active_values_count = 0

  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.max_value.value != blank or filter.min_value.value != blank
        assign active_values_count = active_values_count | plus: 1
      endif
    else
      assign active_values_count = active_values_count | plus: filter.active_values.size
    endif
  endfor

  if section.settings.show_filters and collection.filters.size > 0
    assign show_filters = true
  else
    assign show_filters = false
  endif

  # First, we retrieve, based on the merchant settings, the user preferences and the available space the most appropriate size
  assign products_mobile_grid_mode = cart.attributes.products_mobile_grid_mode

  if request.design_mode
    # In the theme editor we do not use the choice selected manually, to reduce confusion when changing the theme editor values
    assign products_desktop_grid_mode = section.settings.products_size_desktop
  elsif section.settings.show_grid_mode_selector
    assign products_desktop_grid_mode = cart.attributes.products_desktop_grid_mode | default: section.settings.products_size_desktop
  else
    assign products_desktop_grid_mode = section.settings.products_size_desktop
  endif

  if products_mobile_grid_mode == blank or request.design_mode
    if section.settings.products_per_row_mobile == '1'
      assign products_mobile_grid_mode = 'large'
    else
      assign products_mobile_grid_mode = 'medium'
    endif
  endif
-%}

{%- comment -%}
  ------------------------------------------------------------------------------------------------------------------------
  CSS
  ------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    {% comment %}On mobile
    , it's simple! No sidebar or whatever{% endcomment %} --collection-items-per-row-medium: 2; --collection-items-per-row-large: 1; } #shopify-section-{{ section.id }} .product-list { --product-list-max-items-per-row-allowed: 99 !important; {% comment %}On collection page, we explicitly set a number of items so we don't want this{% endcomment %}
}

@media screen and (min-width: 700px) {
  #shopify-section-{{ section.id }} {
    {% comment %}On tablet
    , we do not have any sidebar
    , so we can fix it{% endcomment %}
  --collection-items-per-row-compact: 4;
  --collection-items-per-row-medium: 3;
  --collection-items-per-row-large: 2;
}
}

@media screen and (min-width: 1000px) {
  #shopify-section-{{ section.id }} {
    {%- comment -%}Starting from 1000px it starts to get funky
    , as we can have or not the sidebar{%- endcomment -%}

  {%- if section.settings.filter_layout == 'sidebar' and show_filters -%}
    --collection-items-per-row-compact: 4;
    --collection-items-per-row-medium: 3;
    --collection-items-per-row-large: 2;
  {%- else -%}
    --collection-items-per-row-compact: 6;
    --collection-items-per-row-medium: 4;
    --collection-items-per-row-large: 3;
  {%- endif -%}
}

#shopify-section-{{ section.id }}
.collection {
  {%- if section.settings.filter_layout == 'sidebar' and show_filters -%}
    --collection-grid-template: var(--collection-sidebar-width, 0) minmax(0, 1fr);
  {%- endif -%}
}
}

@media screen and (min-width: 1400px) {
  #shopify-section-{{ section.id }} {
    {%- comment -%}Starting from 1400px we can afford having more content even in sidebar mode{%- endcomment -%}

  {%- if section.settings.filter_layout == 'sidebar' and show_filters -%}
    --collection-items-per-row-compact: 6;
    --collection-items-per-row-medium: 4;
    --collection-items-per-row-large: 3;
  {%- endif -%}
}
}
</style>

{%- comment -%}
  ------------------------------------------------------------------------------------------------------------------------
  LIQUID
  ------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

{%- if collection.handle == 'all' and request.design_mode == false -%}
  <script>
    window.location.replace('{{ routes.root_url }}');
  </script>
  <noscript>
    <meta http-equiv="refresh" content="0;url={{ routes.root_url }}">
  </noscript>
{%- endif -%}

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <div class="container container--{{ section.settings.container_size }} ">
    <div class="v-stack gap-4 sm:gap-5">
      {%- if collection.all_products_count == 0 -%}
        <div class="empty-state">
          <div class="grid gap-6">
            <h1 class="h4">{{ collection.title }}</h1>
            <p>{{ 'collection.general.empty_collection' | t }}</p>

            {%- assign button_content = 'collection.general.continue_shopping' | t -%}
            {%- render 'button'
              , href: routes.all_products_collection_url
              , size: 'xl'
              , style: 'solid'
              , variant: 'primary'
              , content: button_content -%}
          </div>
        </div>
      {%- else -%}
        {%- if show_filters or section.settings.show_sort_by or section.settings.show_grid_mode_selector or section.settings.show_results_count -%}
          <height-observer variable="collection-toolbar" class="collection-toolbar full-bleed md:hidden">
            <div class="collection-toolbar__button-list">

              {%- if show_filters -%}
                <div class="collection-toolbar__button-container">
                  <button
                    type="button"
                    aria-controls="facets-drawer"
                    class="collection-toolbar__button-text w-full">

                    <span class="text-with-icon justify-center  Small Medium text-red">
                      {%- render 'icon' with 'as-roma-filters' -%}
                      {{- 'collection.faceting.filter_button' | t }}
                      {% if active_values_count > 0 %}({{ active_values_count }}){% endif -%}
                    </span>
                  </button>
                </div>
              {%- endif -%}

              {%- if section.settings.show_sort_by -%}
                {%- assign selected_sort_by_value = collection.sort_by | default: collection.default_sort_by -%}

                <div class="collection-toolbar__button-container">
                  <button
                    type="button"
                    aria-controls="sort-by-popover-mobile"
                    class="collection-toolbar__button-text w-full">
                    <span class="text-with-icon justify-center  Small Medium text-red">
                      {%- render 'icon' with 'as-roma-sort' -%}
                      {{- 'collection.faceting.sort_by' | t -}}
                    </span>
                  </button>

                  <facets-sort-popover
                    id="sort-by-popover-mobile"
                    section-id="{{ section.id }}"
                    class="popover popover-sort popover--bottom-end color-scheme color-scheme--dialog"
                    close-on-listbox-select>
                    <div slot="header">
                      <span class="text-with-icon Headline-4 text-red ExtraBold">{%- render 'icon' with 'as-roma-sort' -%}
                        {{ 'collection.faceting.sort_by' | t }}</span>
                    </div>

                    <div class="popover__value-list">
                      {%- comment -%}Define custom sort order: best-selling, price-ascending, price-descending, then others{%- endcomment -%}
                      {%- assign sort_order = 'best-selling,price-ascending,price-descending,title-ascending,title-descending' | split: ',' -%}
                      {%- assign hidden_sorts = 'created-ascending,created-descending,manual' | split: ',' -%}

                      {%- for sort_value in sort_order -%}
                        {%- for sort_option in collection.sort_options -%}
                          {%- if sort_option.value == sort_value and sort_option.name != blank -%}
                            {%- assign is_selected_value = false -%}
                            {%- if sort_option.value == selected_sort_by_value -%}
                              {%- assign is_selected_value = true -%}
                            {%- endif -%}
                            {%- assign id = 'sortby-' | append: sort_option.value -%}
                            <div class="popover__value-option group">
                              {%- render 'checkbox'
                                , name: 'sort_by'
                                , value: sort_option.value
                                , label: sort_option.name
                                , checked: is_selected_value
                                , id_prefix: 'sort-mobile'
                                , type: 'radio'
                                , style: 'checkbox'
                                , id: id -%}
                            </div>
                          {%- endif -%}
                        {%- endfor -%}
                      {%- endfor -%}

                    </div>
                    <div class="popover__button-container">
                      <button
                        type="button"
                        class=" ASRomaFont Small ExtraBold  asroma-button button--solid button-primary Uppercase w-full"
                        id="sort-by-button-mobile">
                        <span class="Body">{{ 'collection.faceting.sort_by' | t }}</span>
                      </button>
                    </div>

                  </facets-sort-popover>
                </div>
              {%- endif -%}


              {%- if section.settings.show_grid_mode_selector -%}
                <div class="collection-toolbar__button-container">
                  <collection-layout-switch
                    device="mobile"
                    class="collection-toolbar__layout-switch-list sm:hidden"
                    aria-controls="product-list-{{ section.id }}">
                    <button
                      type="button"
                      value="large"
                      class="collection-toolbar__button text-red {% if products_mobile_grid_mode == 'large' %}is-active{% endif %}"
                      aria-label="Switch to larger product images">{%- render 'icon' with 'as-roma-collection-layout-1'
, width: 12  
, height: 12 -%}</button>
                    <button
                      type="button"
                      value="medium"
                      class="collection-toolbar__button text-red {% if products_mobile_grid_mode == 'medium' %}is-active{% endif %}"
                      aria-label="Switch to smaller product images">{%- render 'icon' with 'as-roma-collection-layout-2'
, width: 12  
, height: 12 -%}</button>
                  </collection-layout-switch>

                  <collection-layout-switch
                    device="desktop"
                    class="collection-toolbar__layout-switch-list sm-max:hidden"
                    aria-controls="product-list-{{ section.id }}">
                    <button
                      type="button"
                      value="large"
                      class="collection-toolbar__button text-red {% if products_desktop_grid_mode == 'large' %}is-active{% endif %}"
                      aria-label="Switch to larger product images">{%- render 'icon' with 'as-roma-collection-layout-2'
, width: 12  
, height: 12 -%}</button>
                    <button
                      type="button"
                      value="medium"
                      class="collection-toolbar__button text-red {% if products_desktop_grid_mode == 'medium' %}is-active{% endif %}"
                      aria-label="Switch to smaller product images">{%- render 'icon' with 'as-roma-collection-layout-3'
, width: 12  
, height: 12 -%}</button>
                    <button
                      type="button"
                      value="compact"
                      class="collection-toolbar__button text-red {% if products_desktop_grid_mode == 'compact' %}is-active{% endif %}"
                      aria-label="Switch to compact product images">{%- render 'icon' with 'as-roma-collection-layout-4'
, width: 12  
, height: 12 -%}</button>
                  </collection-layout-switch>
                </div>
              {%- endif -%}
            </div>
          </height-observer>

          <height-observer variable="collection-toolbar" class="collection-toolbar  md-max:hidden">

            {%- if section.settings.show_sort_by -%}
              {%- assign selected_sort_by_value = collection.sort_by | default: collection.default_sort_by -%}

              <div class="collection-toolbar__button-container">
                <button
                  type="button"
                  aria-controls="sort-by-popover"
                  class="ASRomaFont  Body Medium asroma-button button--solid button-secondary">
                  <span class="text-with-icon justify-center Body Medium">

                    {%- render 'icon' with 'as-roma-sort' -%}
                    {{- 'collection.faceting.sort_by' | t -}}
                  </span>
                </button>

                <facets-sort-popover
                  id="sort-by-popover"
                  section-id="{{ section.id }}"
                  class="popover popover--bottom-end color-scheme color-scheme--dialog"
                  close-on-listbox-select>
                  <p class="h4" slot="header">{{ 'collection.faceting.sort_by' | t }}</p>

                  <x-listbox class="popover__value-list">
                    {%- comment -%}Define custom sort order: best-selling, price-ascending, price-descending, then others{%- endcomment -%}
                    {%- assign sort_order_desktop = 'best-selling,price-ascending,price-descending,title-ascending,title-descending' | split: ',' -%}

                    {%- for sort_value in sort_order_desktop -%}
                      {%- for sort_option in collection.sort_options -%}
                        {%- if sort_option.value == sort_value and sort_option.name != blank -%}
                          <button
                            type="button"
                            class="popover__value-option group"
                            role="option"
                            value="{{ sort_option.value }}"
                            id="sortby-{{ sort_option.value }}"
                            {% if sort_option.value == selected_sort_by_value %}
                            aria-selected="true"
                            {% endif %}>
                            <span class="reversed-link Body">{{ sort_option.name }}</span>
                          </button>
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endfor -%}
                  </x-listbox>
                </facets-sort-popover>
              </div>
            {%- endif -%}

            <div class="collection-toolbar__button-list-container">

              {%- if show_filters -%}
                <div class="collection-toolbar__button-container md-max:hidden {% if section.settings.filter_layout == 'sidebar' %}md:hidden{% endif %}">
                  <button
                    type="button"
                    aria-controls="facets-drawer"
                    class="ASRomaFont Body Medium asroma-button button--solid button-secondary">

                    {%- render 'icon' with 'as-roma-filters' -%}
                    {{- 'collection.faceting.filter_button' | t }}
                    {% if active_values_count > 0 %}({{ active_values_count }}){% endif -%}
                  </button>
                </div>
              {%- endif -%}


              {%- render 'active-facets'
                , results: collection -%}
            </div>
          </height-observer>
        {%- endif -%}


        {%- if section.settings.show_results_count -%}
          <p class="md-max:hidden Small Medium">
            {{ 'collection.products_count' | t: count: collection.products_count }}
          </p>
        {%- endif -%}
        <div class="collection">

          {%- paginate collection.products by section.settings.products_per_page -%}
            {%- if show_filters -%}
              <facets-drawer id="facets-drawer" class="facets-drawer drawer-filters drawer drawer--sm color-scheme color-scheme--dialog {% if section.settings.filter_layout == 'sidebar' %}md:hidden{% endif %}">
                <div class="Headline-4 ExtraBold Uppercase text-red filters-header" slot="header">
                  {%- render 'icon' with 'as-roma-filters' -%}{{ 'collection.faceting.filters' | t }}
                  {% if active_values_count > 0 %}({{ active_values_count }}){% endif -%}
                </div>

                <div
                  class="filters-drawer__active-facets"
                  hidden
                  data-remove-filter-template="{{ 'collection.faceting.remove_filter' | t: name: '__NAME__' }}"></div>

                {%- render 'facets'
                  , results: collection
                  , show_filters: section.settings.show_filters
                  , open_filters_by_default: section.settings.open_filters_by_default
                  , update_on_change: false
                  , context: 'drawer' -%}

                <div slot="footer">
                  {%- assign button_content = 'collection.faceting.apply_filters' | t -%}
                  {%- assign button_clear = 'collection.faceting.clear_filters' | t -%}

                  <dialog-close-button class="contents button-filters-footer-group">
                    {%- render 'button'
                      , type: 'button'
                      , content: button_clear
                      , style: 'outline'
                      , variant: 'primary'
                      , href: collection.url
                      , stretch: true
                      , id: 'filter-btn-delete-all' -%}

                    {%- render 'button'
                      , type: 'button'
                      , content: button_content
                      , style: 'solid'
                      , variant: 'primary'
                      , stretch: true
                      , id: 'filter-btn-apply-all' -%}
                  </dialog-close-button>
                </div>
              </facets-drawer>

              {%- if section.settings.filter_layout == 'sidebar' -%}
                <safe-sticky class="facets-sidebar md-max:hidden">
                  {%- render 'facets'
                    , results: collection
                    , show_filters: section.settings.show_filters
                    , open_filters_by_default: section.settings.open_filters_by_default
                    , update_on_change: true
                    , context: 'sidebar' -%}
                </safe-sticky>
              {%- endif -%}
            {%- endif -%}

            {%- if collection.products_count == 0 -%}
              <div class="empty-state">
                <div class="v-stack gap-4">
                  <p>{{ 'collection.faceting.no_results' | t }}</p>

                  {%- assign button_content = 'collection.faceting.clear_filters' | t -%}

                  <facet-link>
                    {%- render 'button'
                      , href: collection.url
                      , style: 'solid'
                      , variant: 'primary'
                      , content: button_content -%}
                  </facet-link>
                </div>
              </div>
            {%- else -%}
              <div class="collection__main">

                {%- comment -%} View Item List Data Layer {%- endcomment -%}
                {%- if settings.enable_datalayer -%}
                  {%- capture view_item_list_datalayer -%}
                    {
                      "event": "view_item_list",
                      "ecommerce": {
                        "currency": "{{ cart.currency.iso_code }}",
                        "items": [
                          {%- for product in collection.products -%}
                            {%- render 'datalayer-item', index: forloop.index0, product: product, variant: product.selected_or_first_available_variant, item_list_id: 'PLP', item_list_name: collection.handle -%}  
                            {% unless forloop.last %},{% endunless %}
                          {%- endfor -%}
                        ]
                      }
                    }
                  {%- endcapture -%}
                  {%- comment -%} View Promotion Data Layer - Only products on sale {%- endcomment -%}
                  {%- capture view_promotion_datalayer -%}
                    {
                      "event": "view_promotion",
                      "ecommerce": {
                        "items": [
                          {%- assign promo_index = 0 -%}
                          {%- for product in collection.products -%}
                            {%- assign variant = product.selected_or_first_available_variant -%}
                            {%- if variant.compare_at_price > variant.price -%}
                              {%- assign promo_index = promo_index | plus: 1 -%}
                              {% if promo_index > 1 %},{% endif %}
                              {%- render 'datalayer-item', index: promo_index, product: product, variant: variant, is_small_item: true -%}
                            {%- endif -%}
                          {%- endfor -%}
                        ]
                      }
                    }
                  {%- endcapture -%}
                {%- endif -%}
                <product-list
                  id="product-list-{{ section.id }}"
                  class="product-list"
                  collection-mobile-layout="{{ products_mobile_grid_mode }}"
                  collection-desktop-layout="{{ products_desktop_grid_mode }}"
                  {% if settings.enable_datalayer %}
                  data-datalayer-info='{{ view_item_list_datalayer | strip_newlines | escape }}'
                  data-datalayer-event="view"
                  {%- if promo_index > 0 -%}
                  data-datalayer-info-promotion='{{ view_promotion_datalayer | strip_newlines | escape }}'
                  {%- endif -%}
                  {% endif %}>
                  {%- for product in collection.products -%}
                    {%- render 'product-card'
                      , product: product
                      , reveal: settings.stagger_products_apparition
                      , position: forloop.index
                      , hide_product_information: section.settings.hide_product_information
                      , stacked: true -%}
                  {%- endfor -%}
                </product-list>

                {%- render 'pagination'
                  , paginate: paginate
                  , facet: true -%}
              </div>
            {%- endif -%}
          {%- endpaginate -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<template id="filters-drawer-remove-icon-{{ section.id }}">
  {%- render 'icon' with 'as-roma-close'
    , width: 10 -%}
</template>

<script>
  (() => {
    const sectionId = 'shopify-section-{{ section.id }}';
    const section = document.getElementById(sectionId);

    if (!section || section.__filtersDrawerBadgesInitialized) {
      return;
    }

    section.__filtersDrawerBadgesInitialized = true;

    const BADGE_INPUT_SELECTOR = '[data-filter-badge="true"]';
    const ICON_TEMPLATE_ID = 'filters-drawer-remove-icon-{{ section.id }}';
    const drawerInstances = new WeakMap();

    class DrawerBadges {
      constructor(drawer) {
        this.drawer = drawer;
        this.container = drawer.querySelector('.filters-drawer__active-facets');
        this.form = drawer.querySelector('facets-form form');
        this.iconTemplate = document.getElementById(ICON_TEMPLATE_ID);

        if (!this.container || !this.form) {
          return;
        }

        this.handleUpdate = this.update.bind(this);
        this.handleBadgeClick = this.onBadgeClick.bind(this);

        this.form.addEventListener('change', this.handleUpdate);
        this.form.addEventListener('reset', () => requestAnimationFrame(this.handleUpdate));
        this.container.addEventListener('click', this.handleBadgeClick);

        this.update();
      }

      ensureIcon() {
        const iconRoot = document.getElementById(ICON_TEMPLATE_ID);

        if (iconRoot !== this.iconTemplate) {
          this.iconTemplate = iconRoot;
        }
      }

      cloneIcon() {
        this.ensureIcon();

        if (!this.iconTemplate || !this.iconTemplate.content || !this.iconTemplate.content.firstElementChild) {
          return null;
        }

        return this.iconTemplate.content.firstElementChild.cloneNode(true);
      }

      buildBadge(input) {
        const isBinary = input.type === 'checkbox' || input.type === 'radio';

        if (isBinary && !input.checked) {
          return null;
        }

        if (!isBinary && !input.value) {
          return null;
        }

        const label = input.dataset.filterBadgeLabel || input.value;

        if (!label) {
          return null;
        }

        const group = input.dataset.filterBadgeGroup;
        const badge = document.createElement('div');
        badge.className = 'removable-facet Small Medium';

        const text = document.createElement('span');
        text.className = 'Small Medium';
        text.textContent = label;

        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'removable-facet__remove';

        const labelTemplate = this.container.getAttribute('data-remove-filter-template');
        const ariaLabel = labelTemplate ? labelTemplate.replace('__NAME__', label) : label;
        remove.setAttribute('aria-label', ariaLabel);

        const reference = input.dataset.filterBadgeInput || input.id;

        if (reference) {
          remove.dataset.filterBadgeRemove = reference;
        }

        const icon = this.cloneIcon();

        if (icon) {
          remove.appendChild(icon);
        } else {
          remove.textContent = '×';
        }

        badge.append(text, remove);

        return badge;
      }

      update() {
        if (!this.container || !this.form) {
          return;
        }

        const badges = [];

        this.form.querySelectorAll(BADGE_INPUT_SELECTOR).forEach((input) => {
          if (input.dataset.filterBadgeType === 'price-range') {
            const priceLabel = this.computePriceRangeLabel(input);

            if (priceLabel) {
              input.value = priceLabel;
              input.dataset.filterBadgeLabel = priceLabel;
            } else {
              input.value = '';
              delete input.dataset.filterBadgeLabel;
            }
          }

          const badge = this.buildBadge(input);

          if (badge) {
            badges.push(badge);
          }
        });

        this.container.replaceChildren(...badges);

        if (badges.length === 0) {
          this.container.setAttribute('hidden', '');
        } else {
          this.container.removeAttribute('hidden');
        }
      }

      formatCurrencyForBadge(value, input) {
        const symbol = input.getAttribute('data-filter-badge-currency-symbol') || '';
        const showIso = input.getAttribute('data-filter-badge-show-iso') === 'true';
        const isoCode = input.getAttribute('data-filter-badge-currency-iso') || '';
        const normalized = value === null || value === undefined ? '' : String(value).trim();

        if (normalized === '') {
          return symbol;
        }

        let formatted = symbol + normalized;

        if (showIso && isoCode) {
          formatted += ' ' + isoCode;
        }

        return formatted;
      }

      computePriceRangeLabel(input) {
        const minName = input.getAttribute('data-filter-badge-min-input');
        const maxName = input.getAttribute('data-filter-badge-max-input');

        if (!minName || !maxName) {
          return null;
        }

        const minField = this.form.querySelector('[name="' + minName + '"]');
        const maxField = this.form.querySelector('[name="' + maxName + '"]');
        const minValueRaw = minField && minField.value ? minField.value.trim() : '';
        const maxValueRaw = maxField && maxField.value ? maxField.value.trim() : '';
        const rangeMin = input.getAttribute('data-filter-badge-range-min') || '0';
        let rangeMax = input.getAttribute('data-filter-badge-range-max') || '';

        if (!rangeMax && maxField && maxField.getAttribute('max')) {
          rangeMax = maxField.getAttribute('max');
        }

        if (!rangeMax) {
          return null;
        }

        const effectiveMin = minValueRaw !== '' ? minValueRaw : rangeMin;
        const effectiveMax = maxValueRaw !== '' ? maxValueRaw : rangeMax;
        const isDefault = String(effectiveMin) === String(rangeMin) && String(effectiveMax) === String(rangeMax);

        if (isDefault) {
          return null;
        }

        const minLabel = this.formatCurrencyForBadge(effectiveMin, input);
        const maxLabel = this.formatCurrencyForBadge(effectiveMax, input);

        return minLabel + ' - ' + maxLabel;
      }

      resetPriceRange(badgeInput) {
        const minName = badgeInput.getAttribute('data-filter-badge-min-input');
        const maxName = badgeInput.getAttribute('data-filter-badge-max-input');
        const rangeId = badgeInput.getAttribute('data-filter-badge-range-id');
        const minField = minName ? this.form.querySelector('[name="' + minName + '"]') : null;
        const maxField = maxName ? this.form.querySelector('[name="' + maxName + '"]') : null;
        let priceRangeElement = null;

        if (rangeId) {
          priceRangeElement = document.getElementById(rangeId);
        }

        if (!priceRangeElement && minField && typeof minField.closest === 'function') {
          priceRangeElement = minField.closest('price-range');
        }

        if (!priceRangeElement && maxField && typeof maxField.closest === 'function') {
          priceRangeElement = maxField.closest('price-range');
        }

        if (priceRangeElement) {
          const rangeInputs = priceRangeElement.querySelectorAll('input[type="range"]');
          const lowerRange = rangeInputs[0];
          const upperRange = rangeInputs[1];
          const rangeGroup = priceRangeElement.querySelector('.range-group');
          const rangeMin = badgeInput.getAttribute('data-filter-badge-range-min') || (lowerRange?.getAttribute('min') ?? '0');
          let rangeMax = badgeInput.getAttribute('data-filter-badge-range-max') || upperRange?.getAttribute('max') || upperRange?.value || '';

          if (!rangeMax && maxField && maxField.getAttribute('max')) {
            rangeMax = maxField.getAttribute('max');
          }

          if (lowerRange) {
            lowerRange.value = rangeMin;
          }

          if (upperRange && rangeMax) {
            upperRange.value = rangeMax;
          }

          if (rangeGroup) {
            rangeGroup.style.setProperty('--range-min', '0%');
            rangeGroup.style.setProperty('--range-max', '100%');
          }
        }

        if (minField) {
          minField.value = '';
        }

        if (maxField) {
          maxField.value = '';
        }

        badgeInput.value = '';
        delete badgeInput.dataset.filterBadgeLabel;

        this.update();
        badgeInput.dispatchEvent(new Event('change', { bubbles: true }));
      }

      onBadgeClick(event) {
        const trigger = event.target.closest('[data-filter-badge-remove]');

        if (!trigger) {
          return;
        }

        event.preventDefault();

        const reference = trigger.dataset.filterBadgeRemove;

        if (!reference) {
          return;
        }

        let targetInput = Array.from(this.form.querySelectorAll('[data-filter-badge-input]')).find((input) => input.dataset.filterBadgeInput === reference);

        if (!targetInput) {
          const elementById = document.getElementById(reference);

          if (elementById && this.form.contains(elementById)) {
            targetInput = elementById;
          }
        }

        if (!targetInput) {
          return;
        }

        if (targetInput.dataset.filterBadgeType === 'price-range') {
          this.resetPriceRange(targetInput);
          return;
        }

        if (targetInput.type === 'checkbox' || targetInput.type === 'radio') {
          targetInput.checked = false;
        } else {
          targetInput.value = '';
        }

        targetInput.dispatchEvent(new Event('change', { bubbles: true }));
        this.update();

        if (typeof targetInput.focus === 'function') {
          try {
            targetInput.focus({ preventScroll: true });
          } catch (error) {
            targetInput.focus();
          }
        }
      }
    }

    const setupDrawer = (drawer) => {
      if (drawerInstances.has(drawer)) {
        const existing = drawerInstances.get(drawer);

        if (existing && typeof existing.update === 'function') {
          existing.update();
        }

        return;
      }

      const instance = new DrawerBadges(drawer);
      drawerInstances.set(drawer, instance);
    };

    const setupDrawers = () => {
      section.querySelectorAll('facets-drawer').forEach(setupDrawer);
    };

    setupDrawers();

    let observerScheduled = false;
    const observer = new MutationObserver(() => {
      if (observerScheduled) {
        return;
      }

      observerScheduled = true;

      requestAnimationFrame(() => {
        observerScheduled = false;
        setupDrawers();
      });
    });

    observer.observe(section, { childList: true, subtree: true });

    document.addEventListener('shopify:section:unload', (event) => {
      const target = event.target;

      if (target && target.id === sectionId) {
        observer.disconnect();
      }
    });
  })();

  (() => {
    function applyEllipsis(root) {
      root.querySelectorAll('.filters-container label').forEach((label) => {
        const text = label.textContent.trim();
        if (text && !text.includes(' ')) {
          label.classList.add('label--ellipsis');
        } else {
          label.classList.remove('label--ellipsis');
        }
      });
    }

    const sectionEl = document.getElementById('shopify-section-{{ section.id }}');
    if (sectionEl) {
      applyEllipsis(sectionEl);
      new MutationObserver(() => applyEllipsis(sectionEl))
        .observe(sectionEl, { childList: true, subtree: true });
    }
  })();

  function initSortMobile() {
    const mobilePopover = document.querySelector('#sort-by-popover-mobile');
    if (!mobilePopover) return;

    const sortButton = document.querySelector('#sort-by-button-mobile');
    const radioButtons = mobilePopover.querySelectorAll('input[type="radio"][name="sort_by"]');
    
    if (!sortButton || radioButtons.length === 0) return;

    const newSortButton = sortButton.cloneNode(true);
    sortButton.parentNode.replaceChild(newSortButton, sortButton);

    newSortButton.addEventListener('click', function() {
      const selectedRadio = mobilePopover.querySelector('input[type="radio"][name="sort_by"]:checked');
      
      if (selectedRadio) {
        selectedRadio.dispatchEvent(new CustomEvent("listbox:change", {
          bubbles: true,
          detail: {
            value: selectedRadio.value
          }
        }));
      }
    });
  }

  function initSortDesktop() {
    const desktopPopover = document.querySelector('#sort-by-popover');
    if (!desktopPopover || desktopPopover.dataset.sortDesktopFallbackBound === 'true') return;

    const listbox = desktopPopover.querySelector('x-listbox');
    if (!listbox) return;

    desktopPopover.dataset.sortDesktopFallbackBound = 'true';

    listbox.addEventListener('click', function(event) {
      const option = event.target.closest('[role="option"][value]');
      if (!option || !listbox.contains(option)) return;

      listbox.querySelectorAll('[role="option"]').forEach((item) => {
        item.setAttribute('aria-selected', item === option ? 'true' : 'false');
      });

      desktopPopover.dispatchEvent(new CustomEvent('listbox:change', {
        bubbles: true,
        detail: {
          value: option.value
        }
      }));
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    initSortMobile();
    initSortDesktop();
  });

  document.addEventListener('theme:loading:end', function() {
    const mobilePopover = document.querySelector('#sort-by-popover-mobile');
    if (mobilePopover && mobilePopover.hasAttribute('open')) {
      mobilePopover.removeAttribute('open');
    }
    
    setTimeout(function() {
      initSortMobile();
      initSortDesktop();
    }, 100);
  });
</script>


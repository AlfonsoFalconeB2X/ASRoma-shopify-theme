{%- liquid
  assign active_values_count = 0

  for filter in search.filters
    if filter.type == 'price_range'
      if filter.max_value.value != blank or filter.min_value.value != blank
        assign active_values_count = active_values_count | plus: 1
      endif
    else
      assign active_values_count = active_values_count | plus: filter.active_values.size
    endif
  endfor

  if section.settings.show_filters and search.filters.size > 0
    assign show_filters = true
  else
    assign show_filters = false
  endif
-%}

{%- if search.performed -%}
  {%- if search.results_count > 0 or active_values_count > 0 -%}
    <style>
      #shopify-section-{{ section.id }} {
        --product-list-horizontal-spacing-factor: {{ section.settings.horizontal_spacing_factor }};
        --product-list-vertical-spacing-factor: {{ section.settings.vertical_spacing_factor }};
        --product-list-items-per-row: 2;
      }

      @media screen and (min-width: 700px) {
        #shopify-section-{{ section.id }} {
          --product-list-items-per-row: 3;
        }
      }

      @media screen and (min-width: 1000px) {
        #shopify-section-{{ section.id }} .collection {
          --collection-grid-template: minmax(0, 1fr);
        }
      }

      @media screen and (min-width: 1400px) {
        #shopify-section-{{ section.id }} {
          --product-list-items-per-row: 4;
        }
      }
    </style>

    <script>
          document.addEventListener('DOMContentLoaded', function() {
      var breadcrumbs = document.querySelector('.shopify-section--breadcrumbs');
      if (breadcrumbs) {
        breadcrumbs.style.display = 'none';
      }
          });
    </script>

    {%- paginate search.results by 48 -%}
      <div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
        <div class="w-full full-bleed section-search-header justify-self-center text-center">
          <div class="v-stack gap-4">
            <h1 class="Headline-1 Medium">
              <span class="Uppercase">{{ 'search.general.title' | t }}</span>
              {{ search.terms }}</h1>
          </div>
        </div>
        <div class="container">
          <div class="section-stack">
            <div class="main-search">
              {%- assign product_results = search.results | where: 'object_type', 'product' -%}

              {%- if product_results.size > 0 or active_values_count > 0 -%}
                <div class="main-search__resource-item">
                  <div class="v-stack gap-4 sm:gap-5">
                    {%- if show_filters or section.settings.show_sort_by -%}
                      <height-observer variable="collection-toolbar" class="collection-toolbar full-bleed md:hidden">
                        <div class="collection-toolbar__button-list">
                          {%- if show_filters -%}
                            <div class="collection-toolbar__button-container">
                              <button
                                type="button"
                                aria-controls="facets-drawer"
                                class="collection-toolbar__button-text w-full">
                                <span class="text-with-icon justify-center Small Medium text-red">
                                  {%- render 'icon' with 'as-roma-filters' -%}
                                  {{- 'collection.faceting.filter_button' | t }}
                                  {% if active_values_count > 0 %}({{ active_values_count }}){% endif -%}
                                </span>
                              </button>
                            </div>
                          {%- endif -%}


                          <div class="collection-toolbar__button-list-container justify-center align-center">
                            <p class="Body Medium">{{ 'search.results_count.other' | t: count: search.results_count }}</p>
                          </div>

                          {%- if section.settings.show_sort_by -%}
                            {%- assign selected_sort_by_value = search.sort_by | default: search.default_sort_by -%}

                            <div class="collection-toolbar__button-container">

                              <button
                                type="button"
                                aria-controls="sort-by-popover-mobile"
                                class="collection-toolbar__button-text">
                                <span class="text-with-icon justify-center Small Medium text-red">
                                  {%- render 'icon' with 'as-roma-sort' -%}
                                  {{- 'collection.faceting.sort_by' | t -}}
                                </span>
                              </button>

                              <facets-sort-popover
                                id="sort-by-popover-mobile"
                                section-id="{{ section.id }}"
                                class="popover popover-sort-search popover--bottom-end color-scheme color-scheme--dialog"
                                close-on-listbox-select>
                                <div slot="header">
                                  <span class="text-with-icon Headline-4 text-red ExtraBold">
                                    {%- render 'icon' with 'as-roma-sort' -%}
                                    {{ 'collection.faceting.sort_by' | t }}
                                  </span>
                                </div>

                                <div class="popover__value-list">
                                  {%- for sort_option in search.sort_options -%}
                                    {%- if sort_option.name != blank -%}
                                      {%- assign is_selected_value = false -%}
                                      {%- if sort_option.value == selected_sort_by_value -%}
                                        {%- assign is_selected_value = true -%}
                                      {%- endif -%}
                                      <div class="popover__value-option group">
                                        {%- assign id = 'sortby-' | append: sort_option.value -%}
                                        {%- render 'checkbox'
                                          , name: 'sort_by'
                                          , value: sort_option.value
                                          , label: sort_option.name
                                          , checked: is_selected_value
                                          , id_prefix: 'sort-mobile'
                                          , type: 'radio'
                                          , style: 'checkbox'
                                          , id: id
                                        -%}
                                      </div>
                                    {%- endif -%}
                                  {%- endfor -%}
                                </div>

                                <div class="popover__button-container">
                                  <button
                                    type="button"
                                    class=" ASRomaFont Small ExtraBold  asroma-button button--solid button-primary Uppercase w-full"
                                    id="sort-by-button-mobile">
                                    <span class="Body">{{ 'collection.faceting.sort_by' | t }}</span>
                                  </button>
                                </div>
                              </facets-sort-popover>
                            </div>
                          {%- endif -%}
                        </div>
                      </height-observer>

                      <height-observer variable="collection-toolbar" class="collection-toolbar md-max:hidden">
                        {%- if section.settings.show_sort_by -%}
                          {%- assign selected_sort_by_value = search.sort_by | default: search.default_sort_by -%}

                          <div class="collection-toolbar__button-container">
                            <button
                              type="button"
                              aria-controls="sort-by-popover"
                              class="ASRomaFont Body Medium asroma-button button--solid button-secondary">
                              <span class="text-with-icon justify-center Body Medium">
                                {%- render 'icon' with 'as-roma-sort' -%}
                                {{- 'collection.faceting.sort_by' | t -}}
                              </span>
                            </button>

                            <facets-sort-popover
                              id="sort-by-popover"
                              section-id="{{ section.id }}"
                              class="popover popover--bottom-end color-scheme color-scheme--dialog"
                              close-on-listbox-select>
                              <p class="h4" slot="header">{{ 'collection.faceting.sort_by' | t }}</p>

                              <x-listbox class="popover__value-list">
                                {%- for sort_option in search.sort_options -%}
                                  {%- if sort_option.name != blank -%}
                                    <button
                                      type="button"
                                      class="popover__value-option group"
                                      role="option"
                                      value="{{ sort_option.value }}"
                                      id="sortby-{{ sort_option.value }}"
                                      {% if sort_option.value == selected_sort_by_value %}
                                      aria-selected="true"
                                      {% endif %}>
                                      <span class="reversed-link">{{ sort_option.name }}</span>
                                    </button>
                                  {%- endif -%}
                                {%- endfor -%}
                              </x-listbox>
                            </facets-sort-popover>
                          </div>
                        {%- endif -%}

                        <div class="collection-toolbar__button-list-container">
                          {%- if show_filters -%}
                            <div class="collection-toolbar__button-container md-max:hidden">
                              <button
                                type="button"
                                aria-controls="facets-drawer"
                                class="ASRomaFont Body Medium asroma-button button--solid button-secondary">
                                {%- render 'icon' with 'as-roma-filters' -%}
                                {{- 'collection.faceting.filter_button' | t }}
                                {% if active_values_count > 0 %}({{ active_values_count }}){% endif -%}
                              </button>
                            </div>
                          {%- endif -%}

                          {%- render 'active-facets'
                            , results: search -%}
                        </div>
                      </height-observer>
                    {%- endif -%}

                    <p class="md-max:hidden Body Medium">{{ 'search.results_count.other' | t: count: search.results_count }}</p>

                    <div class="collection">
                      {%- if show_filters -%}
                        {%- capture search_clear_url -%}{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=product&sort_by={{ search.sort_by | default: search.default_sort_by }}{%- endcapture -%}
                        <facets-drawer id="facets-drawer" class="facets-drawer drawer-filters drawer drawer--sm color-scheme color-scheme--dialog">
                          <div class="Headline-4 ExtraBold Uppercase text-red filters-header" slot="header">
                            {%- render 'icon' with 'as-roma-filters' -%}{{ 'collection.faceting.filters' | t }}
                            {% if active_values_count > 0 %}({{ active_values_count }}){% endif -%}
                          </div>

                          {%- render 'facets'
                            , results: search
                            , show_filters: section.settings.show_filters
                            , open_filters_by_default: section.settings.open_filters_by_default
                            , update_on_change: false
                            , context: 'drawer' -%}

                          <div slot="footer">
                            {%- assign button_content = 'collection.faceting.apply_filters' | t -%}
                            {%- assign button_clear = 'collection.faceting.clear_filters' | t -%}

                            <dialog-close-button class="contents button-filters-footer-group">
                              {%- render 'button'
                                , type: 'button'
                                , content: button_clear
                                , style: 'outline'
                                , variant: 'primary'
                                , href: search_clear_url
                                , stretch: true
                                , id: 'filter-btn-delete-all-search' -%}

                              {%- render 'button'
                                , type: 'button'
                                , content: button_content
                                , style: 'solid'
                                , variant: 'primary'
                                , stretch: true
                                , id: 'filter-btn-apply-all-search' -%}
                            </dialog-close-button>
                          </div>
                        </facets-drawer>
                      {%- endif -%}

                      {%- if product_results.size == 0 -%}
                        <div class="empty-state">
                          <div class="v-stack gap-4">
                            <p>{{ 'search.general.no_results' | t: terms: search.terms }}</p>
                          </div>
                        </div>
                      {%- else -%}
                        {%- comment -%} View Item List Data Layer {%- endcomment -%}
                        {%- if settings.enable_datalayer -%}
                          {%- capture view_item_list_datalayer -%}
                            {
                              "event": "view_item_list",
                              "ecommerce": {
                                "currency": "{{ cart.currency.iso_code }}",
                                "items": [
                                  {%- for product in product_results -%}
                                    {%- render 'datalayer-item', index: forloop.index0, product: product, variant: product.selected_or_first_available_variant, item_list_id: 'search', item_list_name: 'search_results' -%}  
                                    {% unless forloop.last %},{% endunless %}
                                  {%- endfor -%}
                                ]
                              }
                            }
                          {%- endcapture -%}
                          {%- comment -%} View Promotion Data Layer - Only products on sale {%- endcomment -%}
                          {%- capture view_promotion_datalayer -%}
                            {
                              "event": "view_promotion",
                              "ecommerce": {
                                "items": [
                                  {%- assign promo_index = 0 -%}
                                  {%- for product in product_results -%}
                                    {%- assign variant = product.selected_or_first_available_variant -%}
                                    {%- if variant.compare_at_price > variant.price -%}
                                      {%- assign promo_index = promo_index | plus: 1 -%}
                                      {% if promo_index > 1 %},{% endif %}
                                      {%- render 'datalayer-item', index: promo_index, product: product, variant: variant, is_small_item: true -%}
                                    {%- endif -%}
                                  {%- endfor -%}
                                ]
                              }
                            }
                          {%- endcapture -%}
                        {%- endif -%}

                        <div class="collection__main">


                          <product-list
                            id="product-list-{{ section.id }}"
                            class="product-list"
                            {% if settings.enable_datalayer %}
                            data-datalayer-info='{{ view_item_list_datalayer | strip_newlines | escape }}'
                            data-datalayer-event="view"
                            {%- if promo_index > 0 -%}
                            data-datalayer-info-promotion='{{ view_promotion_datalayer | strip_newlines | escape }}'
                            {%- endif -%}
                            {% endif %}>
                            {%- for product in product_results -%}
                              {%- render 'product-card'
                                , product: product
                                , stacked: true
                                , reveal: settings.stagger_products_apparition
                                , position: forloop.index -%}
                            {%- endfor -%}
                          </product-list>

                          {%- render 'pagination'
                            , paginate: paginate -%}
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    {%- endpaginate -%}
  {%- else -%}
    <div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
      <div class="container container--xs">
        <div class="empty-state">
          <div class="v-stack gap-4">
            <div class="prose">
              <h1 class="h4">{{ 'search.general.title' | t }}</h1>
              <p>{{ 'search.general.no_results' | t: terms: search.terms }}</p>
            </div>

            <form
              class="main-search-form"
              action="{{ routes.search_url }}"
              method="get"
              role="search">
              {%- assign placeholder = 'search.general.search_placeholder' | t -%}

              <div class="relative">
                {%- render 'input'
                  , type: 'text'
                  , name: 'q'
                  , label: placeholder
                  , autocomplete: 'off'
                  , autocorrect: 'off' -%}
                <button type="submit" class="input-suffix link-faded">{% render 'icon' with 'search' %}</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}
{%- else -%}
  <div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
    <div class="container container--xs">
      <div class="empty-state">
        <div class="v-stack gap-4">
          <div class="prose">
            <h1 class="h4">{{ 'search.general.title' | t }}</h1>
          </div>

          <form
            class="main-search-form"
            action="{{ routes.search_url }}"
            method="get"
            role="search">
            {%- assign placeholder = 'search.general.search_placeholder' | t -%}

            <div class="relative">
              {%- render 'input'
                , type: 'text'
                , name: 'q'
                , label: placeholder
                , autocomplete: 'off'
                , autocorrect: 'off' -%}
              <button type="submit" class="input-suffix link-faded">{% render 'icon' with 'search' %}</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

<script>
  function initSortMobile() {
    const mobilePopover = document.querySelector('#sort-by-popover-mobile');
    if (!mobilePopover) return;

    const sortButton = document.querySelector('#sort-by-button-mobile');
    const radioButtons = mobilePopover.querySelectorAll('input[type="radio"][name="sort_by"]');
    
    if (!sortButton || radioButtons.length === 0) return;

    const newSortButton = sortButton.cloneNode(true);
    sortButton.parentNode.replaceChild(newSortButton, sortButton);

    newSortButton.addEventListener('click', function() {
      const selectedRadio = mobilePopover.querySelector('input[type="radio"][name="sort_by"]:checked');
      
      if (selectedRadio) {
        selectedRadio.dispatchEvent(new CustomEvent("listbox:change", {
          bubbles: true,
          detail: {
            value: selectedRadio.value
          }
        }));
      }
    });
  }

  function initSortDesktop() {
    const desktopPopover = document.querySelector('#sort-by-popover');
    if (!desktopPopover || desktopPopover.dataset.sortDesktopFallbackBound === 'true') return;

    const listbox = desktopPopover.querySelector('x-listbox');
    if (!listbox) return;

    desktopPopover.dataset.sortDesktopFallbackBound = 'true';

    listbox.addEventListener('click', function(event) {
      const option = event.target.closest('[role="option"][value]');
      if (!option || !listbox.contains(option)) return;

      listbox.querySelectorAll('[role="option"]').forEach((item) => {
        item.setAttribute('aria-selected', item === option ? 'true' : 'false');
      });

      desktopPopover.dispatchEvent(new CustomEvent('listbox:change', {
        bubbles: true,
        detail: {
          value: option.value
        }
      }));
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    initSortMobile();
    initSortDesktop();
  });

  document.addEventListener('theme:loading:end', function() {
    const mobilePopover = document.querySelector('#sort-by-popover-mobile');
    if (mobilePopover && mobilePopover.hasAttribute('open')) {
      mobilePopover.removeAttribute('open');
    }

    setTimeout(function() {
      initSortMobile();
      initSortDesktop();
    }, 100);
  });
</script>

{% schema %}
  {
    "name": "t:sections.main_search.name",
    "class": "shopify-section--main-search",
    "tag": "section",
    "settings": [
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:global.colors.scheme",
        "default": "scheme-1"
      },
      {
        "type": "header",
        "content": "t:sections.main_search.product_results_category"
      },
      {
        "type": "checkbox",
        "id": "show_sort_by",
        "label": "t:global.faceting.show_sort_by",
        "default": true
      },
      {
        "type": "range",
        "id": "products_per_page",
        "label": "t:global.faceting.products_per_page",
        "min": 8,
        "max": 50,
        "step": 1,
        "default": 24
      },
      {
        "type": "header",
        "content": "t:global.product_list.spacing_category",
        "info": "t:global.product_list.spacing_category_info"
      },
      {
        "type": "range",
        "min": 0.2,
        "max": 2,
        "step": 0.1,
        "id": "horizontal_spacing_factor",
        "label": "t:global.product_list.horizontal_spacing_factor",
        "default": 1
      },
      {
        "type": "range",
        "min": 0.2,
        "max": 2,
        "step": 0.1,
        "id": "vertical_spacing_factor",
        "label": "t:global.product_list.vertical_spacing_factor",
        "default": 1
      },
      {
        "type": "header",
        "content": "t:sections.main_search.product_filters_category"
      },
      {
        "type": "checkbox",
        "id": "show_filters",
        "label": "t:global.faceting.show_filters",
        "info": "t:global.faceting.show_filters_info",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_filter_group_name",
        "label": "t:global.faceting.show_group_name",
        "info": "t:global.faceting.show_group_name_info",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_filter_values_count",
        "label": "t:global.faceting.show_filter_values_count",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "open_filters_by_default",
        "label": "t:global.faceting.open_filters_by_default",
        "default": false
      },
      {
        "type": "header",
        "content": "t:sections.main_search.blog_post_results_category"
      },
      {
        "type": "checkbox",
        "id": "show_category",
        "label": "t:global.blog.show_category",
        "info": "t:global.blog.show_category_info",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_excerpt",
        "label": "t:global.blog.show_excerpt",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_read_more",
        "label": "t:global.blog.show_read_more",
        "default": true
      }
    ]
  }
{% endschema %}
{%- comment -%}
  ----------------------------------------------------------------------------------------------------------------------
  PERSONAL AREA
  ----------------------------------------------------------------------------------------------------------------------

  Custom section for logged-in users personal area.
  Shows user name and navigation buttons (account, orders, addresses).
  Redirects to login if user is not logged in.
  ********************************************
  Settings
  ********************************************
  * image: metafield image to display on the right
  ********************************************
  Blocks
  ********************************************
  * button: configurable button with URL, title, and icon
{%- endcomment -%}

{%- if customer or request.design_mode -%}

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var breadcrumbs = document.querySelector('.shopify-section--breadcrumbs');
      if (breadcrumbs) {
        breadcrumbs.style.display = 'none';
      }
    });
  </script>

  <div class="personal-area section-spacing">
    <div class="container">
      <div class="personal-area__header">
        <h1 class="personal-area__greeting Heading-1 text-red Medium">{{ 'sections.personal_area.greeting' | t: name: customer.first_name }}</h1>
        {% assign btn_title = 'sections.personal_area.back_to_shop' | t %}
        {% assign logout_title = 'customer.account.logout' | t %}

        <div class="hidden md:block">
          {% render 'button', content: btn_title, style: 'outline', variant: 'primary', extra_classes: 'Uppercase', href: section.settings.back_to_shop_url | default: routes.all_products_collection_url %}

          {% render 'button', content: logout_title, style: 'solid', variant: 'primary', extra_classes: 'Uppercase', href: section.settings.logout_url | default: routes.account_logout_url %}
        </div>
      </div>

      <div class="personal-area__content">
        <div class="personal-area__buttons">

          {%- liquid
            assign season_ticket_type = customer.metafields.custom.season_ticket_type.value
            assign show_season_ticket_banner = false
            assign season_ticket_discount = ''
            unless section.settings.season_ticket_enabled
              assign season_ticket_type = blank
            endunless
            if season_ticket_type == '1' or season_ticket_type == 1
              assign show_season_ticket_banner = true
              assign season_ticket_discount = section.settings.season_ticket_percentage_1
            elsif season_ticket_type == '2' or season_ticket_type == 2
              assign show_season_ticket_banner = true
              assign season_ticket_discount = section.settings.season_ticket_percentage_2
            endif
          -%}

          {%- if show_season_ticket_banner -%}
            {%- assign season_ticket_text_rendered = section.settings.season_ticket_text | replace: '[percentage]', season_ticket_discount -%}
            <div class="personal-area__season-ticket-banner">
              <div class="personal-area__season-ticket-header">
                <div class="personal-area__season-ticket-icon personal-area__button-icon">
                  {%- render 'icon' with 'as-roma-discount'
                    , width: 15
                    , height: 15 -%}
                </div>
                <span class="personal-area__season-ticket-title ExtraSmall Uppercase ExtraBold">{{ section.settings.season_ticket_title | escape }}</span>
              </div>
              <p class="personal-area__season-ticket-text Body">
                {{ season_ticket_text_rendered | escape }}
                {%- if section.settings.season_ticket_link != blank -%}
                  <a href="{{ section.settings.season_ticket_link }}" class="personal-area__season-ticket-link">{{ section.settings.season_ticket_link_text | escape }}</a>
                {%- endif -%}
              </p>
            </div>
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'button' -%}
                <a
                  href="{{ block.settings.link }}"
                  class="personal-area__button"
                  {{ block.shopify_attributes }}>
                  <div class="personal-area__button-icon">
                    {%- render 'icon' with block.settings.icon
                      , width: 24
                      , height: 24 -%}
                  </div>
                  <span class="personal-area__button-title Headline-3 Uppercase ExtraBold">{{ block.settings.title }}</span>
                  <div class="personal-area__button-arrow">
                    {%- render 'icon' with 'as-roma-arrow-dx'
                      , width: 12
                      , height: 19 -%}
                  </div>
                </a>
            {%- endcase -%}
          {%- endfor -%}

          <a
            href="{{ routes.account_profile_url }}"
            class="personal-area__button"
            {{ block.shopify_attributes }}>
            <div class="personal-area__button-icon">
              {%- render 'icon' with 'as-roma-location'
                , width: 24
                , height: 24 -%}
            </div>
            <span class="personal-area__button-title Headline-3 Uppercase ExtraBold">{{ 'customer.addresses.title' | t }}</span>
            <div class="personal-area__button-arrow">
              {%- render 'icon' with 'as-roma-arrow-dx'
                , width: 12
                , height: 19 -%}
            </div>
          </a>
        </div>

        <div class="personal-area__image">
          {%- if section.settings.image != blank -%}
            {%- assign image = section.settings.image -%}
            {{- image | image_url: width: 800 | image_tag: class: 'personal-area__image-img', loading: 'lazy', sizes: '(max-width: 999px) 100vw, 50vw', widths: '400, 600, 800, 1000, 1200'
            -}}
          {%- elsif page.metafields.custom.personal_area_image != blank -%}
            {%- assign image = page.metafields.custom.personal_area_image -%}
            {{- image | image_url: width: 800 | image_tag: class: 'personal-area__image-img', loading: 'lazy', sizes: '(max-width: 999px) 100vw, 50vw', widths: '400, 600, 800, 1000, 1200'
            -}}
          {%- else -%}
            <div class="personal-area__image-placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- else -%}
  {% comment %}
    Redirect to login if user is not logged in
  {% endcomment %}
  <script>
    window.location.href = "{{ routes.account_login_url }}";
  </script>
{%- endif -%}

{% schema %}
  {
    "name": "t:sections.personal_area.name",
    "class": "shopify-section--personal-area",
    "tag": "section",
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "t:sections.personal_area.image",
        "info": "t:sections.personal_area.image_info"
      },
      {
        "type": "url",
        "id": "back_to_shop_url",
        "label": "t:sections.personal_area.back_to_shop_url"
      },
      {
        "type": "url",
        "id": "logout_url",
        "label": "Logout URL"
      },
      {
        "type": "checkbox",
        "id": "season_ticket_enabled",
        "label": "Season Ticket Banner - Attivo",
        "default": true
      },
      {
        "type": "text",
        "id": "season_ticket_title",
        "label": "Season Ticket Banner - Titolo",
        "default": "Sconti dedicati agli abbonati"
      },
      {
        "type": "text",
        "id": "season_ticket_percentage_1",
        "label": "Season Ticket - Percentuale sconto Tipo 1",
        "default": "10%"
      },
      {
        "type": "text",
        "id": "season_ticket_percentage_2",
        "label": "Season Ticket - Percentuale sconto Tipo 2",
        "default": "15%"
      },
      {
        "type": "textarea",
        "id": "season_ticket_text",
        "label": "Season Ticket Banner - Testo (usa [percentage] per la percentuale)",
        "default": "Il tuo abbonamento ti dà diritto al [percentage] su tutti gli acquisti fino al 30 giugno 2026."
      },
      {
        "type": "url",
        "id": "season_ticket_link",
        "label": "Season Ticket Banner - Link URL"
      },
      {
        "type": "text",
        "id": "season_ticket_link_text",
        "label": "Season Ticket Banner - Testo link",
        "default": "Scopri di più"
      }
    ],
    "blocks": [
      {
        "type": "button",
        "name": "t:sections.personal_area.blocks.button.name",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "t:sections.personal_area.blocks.button.title",
            "default": "Account"
          },
          {
            "type": "url",
            "id": "link",
            "label": "t:sections.personal_area.blocks.button.url"
          },
          {
            "type": "select",
            "id": "icon",
            "label": "t:sections.personal_area.blocks.button.icon",
            "options": [
              {
                "value": "as-roma-account",
                "label": "Account"
              },
              {
                "value": "as-roma-cart",
                "label": "Cart"
              },
              {
                "value": "as-roma-wishlist",
                "label": "Wishlist"
              },
              {
                "value": "as-roma-location",
                "label": "Location"
              },
              {
                "value": "as-roma-info",
                "label": "Info"
              },
              {
                "value": "as-roma-search",
                "label": "Search"
              }
            ],
            "default": "as-roma-account"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "t:sections.personal_area.name",
        "blocks": [
          {
            "type": "button",
            "settings": {
              "title": "Account",
              "icon": "as-roma-account"
            }
          },
          {
            "type": "button",
            "settings": {
              "title": "Ordini",
              "icon": "as-roma-cart"
            }
          },
          {
            "type": "button",
            "settings": {
              "title": "Indirizzi",
              "icon": "as-roma-location"
            }
          }
        ]
      }
    ]
  }
{% endschema %}